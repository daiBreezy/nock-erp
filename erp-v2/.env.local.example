# LINE Messaging API — server-side only, never exposed to the browser.
# Copy this file to .env.local (already git-ignored) and fill in real values from
# https://developers.line.biz/console/ → your Provider → your Messaging API channel.
#
# Next.js picks up .env.local automatically in dev (no restart needed) — the
# Settings → LINE Integration page will show "เชื่อมต่อแล้ว" once these are set correctly.

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF app id for the parent-facing Test/Trial form (src/app/liff/form) — from
# https://developers.line.biz/console/ → this channel → LIFF tab → Add.
# NEXT_PUBLIC_ = safe to expose to the browser (this is not a secret, it's meant to be embedded client-side).
NEXT_PUBLIC_LIFF_ID=
