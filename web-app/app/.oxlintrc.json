{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/web/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/app/*", "**/app/*"], "message": "Web/Learn ห้ามใช้โค้ดของ Mobile App — ย้ายของที่ใช้ร่วมไป src/components, data, lib" }] }]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["@/web/*", "**/web/*"], "message": "Mobile App ห้ามใช้โค้ดของ Web/Learn — ย้ายของที่ใช้ร่วมไป src/components, data, lib" }] }]
      }
    }
  ]
}
